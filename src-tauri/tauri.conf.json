{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptNote",
  "version": "0.1.0",
  "identifier": "com.promptnote.desktop",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PromptNote",
        "url": "desktop.html",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": ["main-window", "orb-window"]
    }
  },
  "bundle": {
    "active": false
  }
}
